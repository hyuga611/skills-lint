{
  "name": "@hyuga/skills-lint",
  "version": "0.7.2",
  "description": "Lint Anthropic Agent Skills (SKILL.md) in CI: referential integrity of referenced files + name/trigger collisions between skills. Language-agnostic, zero-dependency.",
  "type": "module",
  "main": "src/check.mjs",
  "exports": {
    ".": "./src/check.mjs"
  },
  "bin": {
    "skills-lint": "src/check.mjs"
  },
  "files": [
    "src",
    "action.yml"
  ],
  "scripts": {
    "poc": "node src/check.mjs examples/bad",
    "test": "node --test"
  },
  "keywords": [
    "skill.md",
    "agent-skills",
    "claude",
    "ai",
    "agent",
    "linter",
    "ci",
    "reference-integrity",
    "trigger-collision",
    "language-agnostic"
  ],
  "license": "MIT",
  "author": "hyuga611",
  "homepage": "https://github.com/hyuga611/skills-lint",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyuga611/skills-lint.git"
  },
  "bugs": {
    "url": "https://github.com/hyuga611/skills-lint/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
